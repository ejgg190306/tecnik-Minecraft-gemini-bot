# Clave API de Gemini (Obtenida en Google AI Studio)
GEMINI_API_KEY=tu_clave_api_gemini_aqui

# Datos del Servidor Minecraft (Exaroton)
MC_HOST=Tecnik.exaroton.me
MC_PORT=39098
MC_USERNAME=bot

# Credenciales de Auto-Login cuando el servidor se reinicia:
# Contraseña para plugins de autenticación dentro del servidor (/login y /register)
MC_LOGIN_PASSWORD=TecnikBot2026!

# Intervalo en milisegundos para comprobar si el servidor está PRENDIDO o APAGADO (por defecto 5000 = 5s)
MC_RECONNECT_INTERVAL=5000

# Modo de autenticación:
# 'offline' para servidores con online-mode=false (No-Premium)
# 'microsoft' si el servidor tiene online-mode=true (requiere cuenta original)
MC_AUTH_MODE=offline

# Versión del juego (ej: 26.1 para Purpur 26.1)
MC_VERSION=26.1
